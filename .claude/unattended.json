{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Bash(labpipe *)",
      "Edit(**/analysis/**/notes.md)",
      "Edit(**/logs/**)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Edit(**/config/**)",
      "Edit(**/.claude/**)",
      "Edit(**/src/**)",
      "Edit(**/references/**)",
      "Bash(git *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "network": {
      "allowedDomains": []
    }
  }
}
