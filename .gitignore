# Pipeline state and derived outputs: regenerable from provenance.json, never committed.
/analysis/
/logs/
/manifest.json
/manifest.lock

# Raw data must never enter this repository.
*.xrdml
*.xy
*.rd
!tests/fixtures/**

__pycache__/
*.egg-info/
.pytest_cache/
build/

# Machine-specific paths (raw data location, protected folders)
/config/local.yaml

# Your lab's own settings: sample presets, sample-ID answers, per-measurement steering.
# Recorded in every provenance.json; back them up or keep them in a private repo.
/config/samples.yaml
/config/lab.yaml
/config/sample_ids.yaml
/config/measurements/
/config/ignore.yaml

# Project context (aims, documents, literature): yours, never committed
/context/

# Agent files generated by `labpipe agents sync` from agents/*.md (Claude Code, OpenCode, Codex)
/.claude/agents/
/.opencode/agents/
/.codex/agents/
/.labpipe-installed
